<resources>
    <!-- Base application theme. -->
    <style name="Theme.GravAssist" parent="Theme.Material3.DayNight">
        <item name="colorPrimary">@color/accent_primary</item>
        <item name="colorSecondary">@color/accent_secondary</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:windowBackground">@color/bg_dark</item>
    </style>

    <style name="Theme.GravAssist.NoActionBar" parent="Theme.GravAssist">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
</resources>
